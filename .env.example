# VoiceAI — environment variable template
# Never commit your real .env file to GitHub.

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini — text and dialogue generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs — voices and text-to-speech
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY

# OpenAI — optional speech-to-text and text tools
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Payments — configure only when integrating billing
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID=YOUR_STRIPE_PRICE_ID

# Optional public client configuration
# Only expose values explicitly intended for browser use.
PUBLIC_APP_NAME=VoiceAI
